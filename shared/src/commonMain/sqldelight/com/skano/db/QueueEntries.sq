CREATE TABLE queue_entries (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  queue_id INTEGER NOT NULL REFERENCES scan_queues(id) ON DELETE CASCADE,
  record_id INTEGER NOT NULL REFERENCES scan_records(id) ON DELETE CASCADE,
  quantity INTEGER NOT NULL DEFAULT 1,
  added_at INTEGER NOT NULL,
  UNIQUE (queue_id, record_id)
);

incrementEntry:
UPDATE queue_entries
SET quantity = quantity + 1
WHERE queue_id = :queue_id AND record_id = :record_id;

insertEntry:
INSERT INTO queue_entries(queue_id, record_id, quantity, added_at)
VALUES (:queue_id, :record_id, 1, :added_at);

selectQueueEntries:
SELECT
  queue_entries.id AS id,
  queue_entries.quantity AS quantity,
  queue_entries.added_at AS added_at,
  scan_records.raw_value AS raw_value,
  scan_records.format AS format,
  scan_records.note AS note,
  labels.name AS label_name
FROM queue_entries
JOIN scan_records ON scan_records.id = queue_entries.record_id
LEFT JOIN labels ON labels.id = scan_records.label_id
WHERE queue_entries.queue_id = :queue_id
ORDER BY queue_entries.added_at, queue_entries.id;

deleteQueueEntry:
DELETE FROM queue_entries WHERE id = :id;

clearQueue:
DELETE FROM queue_entries WHERE queue_id = :queue_id;
